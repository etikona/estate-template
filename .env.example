# Public URL of the deployed site (used for SEO, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-client-domain.com

# Contact form email (any SMTP provider). Leave empty in development:
# enquiries are then printed to the terminal instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=hello@your-client-domain.com
CONTACT_FROM="Website <hello@your-client-domain.com>"
